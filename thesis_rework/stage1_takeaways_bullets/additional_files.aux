\@writefile{lot}{\contentsline {table}{\numberline {S.3}{\ignorespaces \textbf  {Table C: the 200 descriptors that make up the PDV representation.} One entry is one feature of the vector, in the order the pipeline computes them. The list is fixed in the code rather than taken from RDKit's current default set, which grows between releases, so the same 200 features are built on every dataset and in every run. They were computed with RDKit 2022.09.5. Descriptors that return a non-finite value on a molecule have that value replaced by zero before the standardization constants are computed. Source: \texttt  {DEFAULT\_DESCRIPTOR\_LIST} in \texttt  {scripts/process\_and\_train.py}.}}{12}{table.1.3}\protected@file@percent }
\newlabel{af1:pdv}{{S.3}{12}{\textbf {Table C: the 200 descriptors that make up the PDV representation.} One entry is one feature of the vector, in the order the pipeline computes them. The list is fixed in the code rather than taken from RDKit's current default set, which grows between releases, so the same 200 features are built on every dataset and in every run. They were computed with RDKit 2022.09.5. Descriptors that return a non-finite value on a molecule have that value replaced by zero before the standardization constants are computed. Source: \texttt {DEFAULT\_DESCRIPTOR\_LIST} in \texttt {scripts/process\_and\_train.py}}{table.1.3}{}}
\newlabel{app:noise:sec:excluded_configurations}{{2}{13}{Noise robustness across molecular representations and model architectures}{addfile.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S.4}{\ignorespaces \textbf  {Scaffold folds excluded from the robustness analysis.} One row is one model on one representation under one noise condition, in one scaffold fold, that has no \ensuremath  {\mathrm  {AUC}_{\mathrm  {norm}}}{}. Every exclusion is a clean $R^2$ below 0.3, the gate below which a ratio to the clean baseline is unstable; its clean $R^2$ is given. All excluded folds are on the three assay datasets: no QM9 replicate fell below the gate.}}{13}{table.1.4}\protected@file@percent }
\newlabel{app:noise:excluded_configurations}{{S.4}{13}{\textbf {Scaffold folds excluded from the robustness analysis.} One row is one model on one representation under one noise condition, in one scaffold fold, that has no \aucnorm {}. Every exclusion is a clean $R^2$ below 0.3, the gate below which a ratio to the clean baseline is unstable; its clean $R^2$ is given. All excluded folds are on the three assay datasets: no QM9 replicate fell below the gate}{table.1.4}{}}
