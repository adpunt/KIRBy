\newlabel{app:noise:sec:model_redundancy}{{3}{22}{Noise robustness across molecular representations and model architectures}{addfile.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S.5}{\ignorespaces \textbf  {Candidate model families: how often two models differ by less than their split-to-split variation.} Each row is one pair of base models considered for a family. Each cell counts the representations, of six, on which the two differ by less than their split-to-split standard deviation, followed by the range of the absolute difference. Grouped says whether the pair shares a family in the ANOVA. Outcomes are clean $R^2$ and \ensuremath  {\mathrm  {AUC}_{\mathrm  {norm}}}{} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split standard deviation is that of the two members' values over the splits.}}{22}{table.1.5}\protected@file@percent }
\newlabel{app:noise:family_pairs_models}{{S.5}{22}{\textbf {Candidate model families: how often two models differ by less than their split-to-split variation.} Each row is one pair of base models considered for a family. Each cell counts the representations, of six, on which the two differ by less than their split-to-split standard deviation, followed by the range of the absolute difference. Grouped says whether the pair shares a family in the ANOVA. Outcomes are clean $R^2$ and \aucnorm {} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split standard deviation is that of the two members' values over the splits}{table.1.5}{}}
\newlabel{app:noise:sec:tukey_within_families}{{4}{22}{Noise robustness across molecular representations and model architectures}{addfile.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S.6}{\ignorespaces \textbf  {Tukey HSD between the members of each model family.} One test per representation and outcome, after removing each split's mean. Each cell counts the representations, of six, on which the pair differs at adjusted $p < 0.05$, followed by the range of the absolute difference. With ten splits the test detects differences smaller than the split-to-split variation, so the size of each difference is given beside it.}}{22}{table.1.6}\protected@file@percent }
\newlabel{app:noise:family_tukey}{{S.6}{22}{\textbf {Tukey HSD between the members of each model family.} One test per representation and outcome, after removing each split's mean. Each cell counts the representations, of six, on which the pair differs at adjusted $p < 0.05$, followed by the range of the absolute difference. With ten splits the test detects differences smaller than the split-to-split variation, so the size of each difference is given beside it}{table.1.6}{}}
