\newlabel{app:noise:sec:model_redundancy}{{4}{23}{Noise robustness across molecular representations and model architectures}{addfile.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S.5}{\ignorespaces \textbf  {Candidate model families: how often two models differ by less than their split-to-split variation.} Each row is one pair of base models considered for a family. Each cell counts the representations, of six, on which the two differ by less than their split-to-split SD, followed by the range of the absolute difference. Grouped says whether the pair shares a family in the ANOVA. Outcomes are clean $R^2$ and \ensuremath  {\mathrm  {AUC}_{\mathrm  {norm}}}{} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split SD is that of the two members' values over the splits.}}{23}{table.1.5}\protected@file@percent }
\newlabel{app:noise:family_pairs_models}{{S.5}{23}{\textbf {Candidate model families: how often two models differ by less than their split-to-split variation.} Each row is one pair of base models considered for a family. Each cell counts the representations, of six, on which the two differ by less than their split-to-split SD, followed by the range of the absolute difference. Grouped says whether the pair shares a family in the ANOVA. Outcomes are clean $R^2$ and \aucnorm {} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split SD is that of the two members' values over the splits}{table.1.5}{}}
