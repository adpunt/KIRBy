\newlabel{app:noise:sec:variance_intervals}{{7}{25}{Noise robustness across molecular representations and model architectures}{addfile.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S.8}{\ignorespaces \textbf  {Intervals for the shares of variance in the decomposition tables.} One row is one term of one decomposition: a dataset, a noise condition, and an outcome. The share is the one printed in Chapter~\ref {chap:robustness}; the lower and upper ends are its 95\% interval from 1,000 bootstrap resamples of whole replicates. QM9 has 10 replicates; on each assay dataset a replicate is one of five scaffold folds, so its interval rests on five. Predictive performance under noise is $R^2$ at each dataset's reporting noise level: 1.0 on QM9, LogD, and hERG $K_i$, and 0.75 on Caco-2.}}{25}{table.1.8}\protected@file@percent }
\newlabel{app:noise:variance_intervals}{{S.8}{25}{\textbf {Intervals for the shares of variance in the decomposition tables.} One row is one term of one decomposition: a dataset, a noise condition, and an outcome. The share is the one printed in Chapter~\ref {chap:robustness}; the lower and upper ends are its 95\% interval from 1,000 bootstrap resamples of whole replicates. QM9 has 10 replicates; on each assay dataset a replicate is one of five scaffold folds, so its interval rests on five. Predictive performance under noise is $R^2$ at each dataset's reporting noise level: 1.0 on QM9, LogD, and hERG $K_i$, and 0.75 on Caco-2}{table.1.8}{}}
