\@writefile{lot}{\contentsline {table}{\numberline {S.6}{\ignorespaces \textbf  {Tukey HSD between the members of each model family.} One test per representation and outcome, after removing each split's mean. Each cell counts the representations, of six, on which the pair differs at adjusted $p < 0.05$, followed by the range of the absolute difference. With ten splits the test detects differences smaller than the split-to-split variation, so the size of each difference is given beside it.}}{24}{table.1.6}\protected@file@percent }
\newlabel{app:noise:family_tukey}{{S.6}{24}{\textbf {Tukey HSD between the members of each model family.} One test per representation and outcome, after removing each split's mean. Each cell counts the representations, of six, on which the pair differs at adjusted $p < 0.05$, followed by the range of the absolute difference. With ten splits the test detects differences smaller than the split-to-split variation, so the size of each difference is given beside it}{table.1.6}{}}
