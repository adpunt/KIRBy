\@writefile{lot}{\contentsline {table}{\numberline {S.7}{\ignorespaces \textbf  {Candidate representation groups: how often two representations differ by less than their split-to-split variation.} Each row is one pair of representations considered for a group. Each cell counts the base models on which the two differ by less than their split-to-split SD, followed by the range of the absolute difference. No pair was grouped. Outcomes are clean $R^2$ and \ensuremath  {\mathrm  {AUC}_{\mathrm  {norm}}}{} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split SD is that of the two members' values over the splits.}}{24}{table.1.7}\protected@file@percent }
\newlabel{app:noise:family_pairs_representations}{{S.7}{24}{\textbf {Candidate representation groups: how often two representations differ by less than their split-to-split variation.} Each row is one pair of representations considered for a group. Each cell counts the base models on which the two differ by less than their split-to-split SD, followed by the range of the absolute difference. No pair was grouped. Outcomes are clean $R^2$ and \aucnorm {} under the three noise conditions every representation ran, on QM9. The difference is the mean over the ten splits of one member minus the other, paired on the split; the split-to-split SD is that of the two members' values over the splits}{table.1.7}{}}
